<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="ld250_tm12x_soft_two_fingers">

	<!-- Arguments -->
	<xacro:arg name="ns" default=""/>
	<xacro:arg name="arm_prefix" default=""/>
	<xacro:arg name="base_prefix" default=""/>
	<xacro:arg name="arm_color" default="none"/>
	<xacro:arg name="trans_hw_iface" default="hardware_interface/PositionJointInterface"/>
	<xacro:arg name="arm_base_link" default="base_link"/>
	<xacro:arg name="controlbox_mesh_pkg" default="moma_description"/>

	<xacro:include filename="$(find moma_description)/xacro/ld250_tm12x.urdf.xacro" />
	<xacro:include filename="$(find grasping_description)/xacro/tmee-spacer/tmee-spacer.urdf.xacro" />
	<xacro:include filename="$(find gripper_description)/xacro/two-finger-gripper.urdf.xacro" />

	<xacro:ld250_tm12x_robot
		ns="$(arg ns)"
		arm_prefix="$(arg arm_prefix)"
		base_prefix="$(arg base_prefix)"
		arm_color="$(arg arm_color)"
		trans_hw_iface="$(arg trans_hw_iface)"
		arm_base_link="$(arg arm_base_link)"
		controlbox_mesh_pkg="$(arg controlbox_mesh_pkg)" />

	<xacro:tmee_spacer
		parent="$(arg arm_prefix)flange"
		prefix="$(arg arm_prefix)"
		xyz="0 0 0"
		rpy="0 0 0" />

	<xacro:two_finger_gripper
		parent="$(arg arm_prefix)tmee_spacer_link"
		prefix="$(arg arm_prefix)"
		xyz="0 0 0.008"
		rpy="0 0 0" />

</robot>
